# ==========================================
# Audio Studio & Python .gitignore
# ==========================================

# Operating System Files & Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
__MACOSX/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.env
.venv
venv/
ENV/
env/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary Recording & Processing Files
*.tmp
*.temp
*.wav
temp/
tmp/
studio/temp/
*.log

# Compressed Archives
*.zip
*.tar.gz
*.7z
